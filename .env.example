# ================================================================
# VITRINA PMR — Пример переменных окружения
# Скопируй этот файл в .env и заполни реальными значениями
# ================================================================

# ---- База данных: PostgreSQL (Neon) ----
# Основная строка подключения (через pgBouncer — для prod)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"

# Прямое подключение (без pgBouncer — для Prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- NextAuth ----
# Генерация: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-secret-here"
# В prod заменить на реальный домен с https://
NEXTAUTH_URL="https://your-domain.com"

# ---- Cloudinary (загрузка изображений) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- SMTP / Email (Отправка писем для сброса пароля) ----
# Например, для Yandex: smtp.yandex.ru, порт 465, secure: true
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT=465
SMTP_USER="your-shop@yandex.ru"
# Пароль приложения (App Password), а не пароль от почты!
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="Vitrina PMR <your-shop@yandex.ru>"

# Yandex Metrika ID (например: 97891234)
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# ---- Upstash Redis (Rate limiting для Vercel / serverless) ----
# Бесплатно на https://console.upstash.com или через Vercel Storage
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
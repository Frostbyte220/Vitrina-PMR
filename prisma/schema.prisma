generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String    // Название магазина / Имя владельца
  email        String    @unique
  password     String?
  instagram    String    
  instagramUrl String?   
  avatar       String?   
  products     Product[]
  store        Store?    // <-- Связь с расширенными настройками магазина
  resetTokens  PasswordResetToken[]
  favorites    String[]  @default([]) // ID товаров в избранном (синхронизируются с клиентом)
  createdAt    DateTime  @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// <-- Модель Профиль/Витрина магазина -->
model Store {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String   
  slug        String   @unique 
  description String?  
  instagram   String?  
  phone       String?  
  telegram    String?  
  viber       String?  
  cities      String[] 
  
  avatarUrl   String?  
  coverUrl    String?  

  isVerified  Boolean  @default(false) // Бейдж проверенного магазина
  viewsCount  Int      @default(0)     // Количество просмотров страницы магазина

  // 🔥 Добавьте эту строку для связи с продуктами
  products    Product[] 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String    @id @default(uuid())
  title       String
  price       Float
  oldPrice    Float?
  category    String    @default("Разное")
  subCategory String?   
  images      String[]  
  description String?
  sizes       String[]  @default([])
  status      String?   @default("Активен")
  availability String?   @default("В наличии") // "В наличии", "Под заказ", "Ожидается"
  deletedAt   DateTime? 

  // Связь с продавцом
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🔥 НОВОЕ: Связь товара с магазином (для корректной работы include: { store: true })
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Связь с жалобами на товар
  reports     ProductReport[]

  // Аналитика и статистика товара
  viewsCount         Int       @default(0) // Количество просмотров товара
  contactClicksCount Int       @default(0) // Количество кликов по кнопкам связи (Telegram/Viber/Instagram/тел)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Индексы для быстрой фильтрации на главной странице
  @@index([status, deletedAt, createdAt(sort: Desc)])
  @@index([category, status, deletedAt])
  @@index([userId])
  @@index([storeId])
}

// Модель жалобы на товар (модерация контента)
model ProductReport {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason      String   // Причина жалобы
  details     String?  // Дополнительный комментарий
  status      String   @default("PENDING") // PENDING (Ожидает), RESOLVED (Товар скрыт/решено), DISMISSED (Отклонено)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([productId])
}

// Модель рекламного баннера / промо-акции
model Banner {
  id        String   @id @default(cuid())
  title     String   // Заголовок баннера
  sub       String?  // Подзаголовок / описание
  label     String?  // Бейдж ("Реклама", "Акция", "Партнёр", "Новинка")
  cta       String   @default("Подробнее") // Текст кнопки перехода
  href      String   @default("/") // Ссылка перехода
  bg        String   @default("from-rose-600 to-rose-800") // Градиент фона (tailwind классы)
  emoji     String?  @default("✨") // Эмодзи-иконка
  imageUrl  String?  // URL картинки (если баннер графический)
  isActive  Boolean  @default(true) // Активен ли баннер
  order     Int      @default(0) // Порядок отображения (0, 1, 2...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}